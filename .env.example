# Copy to .env and fill in the values you want.
# All variables are optional — the stack runs fine with empty secrets.

# Stockbit JWT for the Stockbit feed / bandarmology detector.
STOCKBIT_JWT_TOKEN=

# Gemini API key for the bot pipeline (optional).
GEMINI_API_KEY=

# Cache TTLs (seconds).
YFINANCE_CACHE_TTL=3600
YFINANCE_HISTORY_CACHE_TTL=43200
FOREX_CACHE_TTL=3600

# Flow research cache (SQLite at backend/data/cache/cache.db).
FLOW_CACHE_TTL=300
FLOW_CACHE_TTL_VALIDATE=3600
FLOW_CACHE_STALE_DAYS=7
# Daily market snapshot freshness (seconds).
OVERVIEW_CACHE_TTL=900
# Optional licensed date,ticker,lpm CSV for a vendor-parity report.
FLOW_VENDOR_CSV=

# CORS allow-list for the frontend origin.
CORS_ORIGINS=http://localhost:3000

# Where the browser reaches the API. Defaults to the host-published port.
NEXT_PUBLIC_API_URL=http://localhost:8000

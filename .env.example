# Copy to .env and fill in the values you want.
# All variables are optional — the stack runs fine with empty secrets.

# Stockbit: the local stockbitd session keeper (default port). The runner
# starts it when it is built; the backend proxies its JSON for the /stockbit
# screen and Flow's optional broker rows. Set this empty to disable the daemon
# and fall back to STOCKBIT_JWT_TOKEN below.
STOCKBITD_URL=http://127.0.0.1:8787
# Optional timeout for the local daemon (seconds).
STOCKBITD_TIMEOUT=8

# One-time automatic sign-in for the local daemon. The suite's /stockbit page
# can save these instead; the backend copies a legacy .env pair into the daemon
# once, and the daemon fills Stockbit's own login form for you. Leave blank to
# use the page's form. The password is stored on this machine only.
STOCKBIT_USERNAME=
STOCKBIT_PASSWORD=

# Legacy shortcut: a Stockbit JWT used only when STOCKBITD_URL is empty.
STOCKBIT_JWT_TOKEN=

# Gemini API key for the bot pipeline (optional).
GEMINI_API_KEY=

# Cache TTLs (seconds).
YFINANCE_CACHE_TTL=3600
YFINANCE_HISTORY_CACHE_TTL=43200
FOREX_CACHE_TTL=3600

# Weekly local market store (SQLite; default backend/data/market.db). The
# `./trading-suite sync-data` job writes it; the app reads it for daily history
# and the persisted plan. Leave unset for the default.
# MARKET_DB=backend/data/market.db
# How long a persisted plan stays readable (seconds; default 8 days; the
# computed-cache hard stale is 7 days). The weekly sync re-warms it.
# PLAN_CACHE_TTL_SECONDS=691200
# The study checkout: the source of record and the sync's default study root.
# TRADING_DOCS_DIR=/home/you/Projects/trading-backtest-docs

# Flow research cache (SQLite at backend/data/cache/cache.db).
FLOW_CACHE_TTL=300
FLOW_CACHE_TTL_VALIDATE=3600
FLOW_CACHE_STALE_DAYS=7
# Daily market snapshot freshness (seconds).
OVERVIEW_CACHE_TTL=900
# Optional licensed date,ticker,lpm CSV for a vendor-parity report.
FLOW_VENDOR_CSV=

# CORS allow-list for the frontend origin.
CORS_ORIGINS=http://localhost:3000

# Where the browser reaches the API. Defaults to the host-published port.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional integrations ────────────────────────────────────────────────────
# Stockbit JWT token — enables bandarmology market-detector feeds
STOCKBIT_JWT_TOKEN=

# Gemini API key — enables AI news summaries (news_analyzer)
GEMINI_API_KEY=

# ── Cache TTLs (seconds) ─────────────────────────────────────────────────────
YFINANCE_CACHE_TTL=3600
YFINANCE_HISTORY_CACHE_TTL=43200
FOREX_CACHE_TTL=3600

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# The app and the API on one origin: /api goes to FastAPI, everything else is
# the built SPA. Same origin means no CORS config, and the Android app can point
# at https://<domain> with no port.
{$DOMAIN:localhost} {
	encode gzip

	@api path /api/*
	reverse_proxy @api backend:8000

	root * /srv
	try_files {path} /index.html
	file_server
}

@startuml 05-sequence-screener
skinparam backgroundColor white
skinparam defaultFontName Inter, Helvetica, Arial
skinparam defaultFontSize 11
skinparam Shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #475569
skinparam ArrowThickness 1.2

title Scanner — one universe pass, measured filters

actor User
participant "ScannerPage" as FE
participant "FastAPI /api/scanner" as API
participant "plan.scan_payload" as Payload
participant "screen._score_universe" as Screen
database "cache.db" as Cache
participant "bars adapter" as Bars

User -> FE : Open /
FE -> API : GET /api/scanner
API -> Payload : scan_payload(as_of)
Payload -> Cache : read computed:scan:v1:*
alt warm
  Cache --> Payload : persisted payload
else cold
  Payload -> Bars : load frames
  Bars --> Payload : Frames + benchmark
  Payload -> Screen : _score_universe(frames, session, spec)
  Screen -> Screen : one _evaluate per name
  Screen --> Payload : regime + scored[]
  Payload -> Payload : scan_rows + screen_registry + index_context
  Payload -> Cache : write computed:scan:v1:*
end
Payload --> API : rows, screens, evidence, index context
API --> FE : JSON
FE --> User : table, filters, counts

note right of Screen
 The same gate chain as /api/plan.
 Tier 1 = record["passed"]
 Conditions = breakout, RS, quiet
 Capitulation = cap_watch set
end note
@enduml
